# Required for live analysis. Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
REPEAT_MODEL=claude-opus-5-5

# Optional. Postgres connection string (Neon, Supabase, Vercel Postgres...).
# Without it, feedback and usage counters are written to ./.data (local dev only;
# not persistent on serverless hosts).
DATABASE_URL=

# Abuse limits for the analysis endpoint.
REPEAT_MAX_ANALYSES_PER_IP_PER_DAY=5
REPEAT_MAX_ANALYSES_PER_DAY=200

# Salt for hashing IP addresses before storage. Set to a long random string.
IP_HASH_SALT=change-me

# Local development only: return a canned, clearly-labelled report without calling the model.
REPEAT_MOCK=0

# Public URL of this deployment, used for metadata and the sitemap.
# Standalone: https://repeat.theauthority.company
NEXT_PUBLIC_SITE_URL=https://theauthority.company

# Standalone Repeat on its own subdomain (company site hosted elsewhere, e.g. Lovable).
# 1 = "/" goes to Repeat and company links point to NEXT_PUBLIC_COMPANY_URL.
NEXT_PUBLIC_REPEAT_STANDALONE=0
NEXT_PUBLIC_COMPANY_URL=https://theauthority.company

# Limits for the website-first report and its answer-driven updates.
REPEAT_MAX_QUICK_PER_IP_PER_DAY=25
REPEAT_MAX_QUICK_PER_DAY=600
